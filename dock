version: "3.9"

services:
  backend:
    image: sonaishub/sonais:backend-v1.0.1
    container_name: sonai-backend
    restart: unless-stopped
    env_file:
      - ./backend/.env
    ports:
      - "8000:8000"
    networks:
      - sonai-network

  frontend:
    image: sonaishub/sonais:frontend-v1.0.1
    container_name: sonai-frontend
    restart: unless-stopped
    ports:
      - "5000:80"
    depends_on:
      - backend
    networks:
      - sonai-network

networks:
  sonai-network:
    driver: bridge
